/* ===================================
   TABS STYLES
   =================================== */
.tabs {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 0 1rem;
}

.tab-btn {
    background-color: transparent;
    border: 2px solid var(--primary-color);
    color: var(--text-color);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    width: auto;
}

.tab-btn:hover {
    background-color: rgba(59, 130, 246, 0.1); /* light blue tint */
}

.tab-btn.active {
    background-color: var(--primary-color);
    color: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.tab-content {
    display: block;
    animation: fadeIn 0.3s ease;
}

.tab-content.hidden {
    display: none;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ===================================
   LEAGUE DISCOVERY STYLES
   =================================== */
.search-box {
    margin-bottom: 1.5rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
}

.search-box input {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background-color: white;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.search-box input:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

.action-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
}

.status-text {
    font-size: 0.9rem;
    color: #64748b;
}

.leagues-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 1rem 0;
}

.league-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow);
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: transform 0.2s ease;
}

.league-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.league-card.major-league {
    border-color: var(--secondary-color);
    background: linear-gradient(to bottom right, #ffffff, #f0fdf4); /* Slight green tint */
}

.league-logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
}

.league-info h4 {
    margin: 0 0 0.25rem 0;
    color: #0f172a;
    font-size: 1.1rem;
}

.league-info p {
    margin: 0;
    color: #64748b;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.league-tag {
    display: inline-block;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
    font-weight: 600;
    text-transform: uppercase;
    margin-top: 0.5rem;
}

.tag-popular {
    background-color: var(--secondary-color);
    color: white;
}

.tag-type {
    background-color: #f1f5f9;
    color: #64748b;
}

.placeholder-message {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: #94a3b8;
    background: #f8fafc;
    border-radius: 12px;
    border: 2px dashed #e2e8f0;
}
